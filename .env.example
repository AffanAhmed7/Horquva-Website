# Resend (https://resend.com) — enquiry form delivery
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Horquva website <website@horquva.com>"
ENQUIRY_FROM_EMAIL=

# --- RAG Chatbot (WOBA) Configuration (All Free Tiers) ---
# Groq (Primary Free Inference — https://console.groq.com)
GROQ_API_KEY=

# OpenRouter (Fallback Free Inference — https://openrouter.ai)
OPENROUTER_API_KEY=

# Upstash Vector (Free Vector DB with Built-in Embeddings — https://console.upstash.com)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Upstash Redis (Free Session History + per-visitor chat rate limit — https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RAG Ingestion Secret (required: POST /api/rag/ingest refuses every request while this is empty)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then load the site content with: npm run rag:index -- https://horquva.com
RAG_INGEST_SECRET=
