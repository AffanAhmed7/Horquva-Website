# Resend (https://resend.com) — enquiry form delivery
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Horquva website <website@horquva.com>"
ENQUIRY_FROM_EMAIL=

# --- RAG Chatbot (WOBA) Configuration (All Free Tiers) ---
# Groq (Primary Free Inference — https://console.groq.com)
GROQ_API_KEY=

# OpenRouter (Fallback Free Inference — https://openrouter.ai)
OPENROUTER_API_KEY=

# Upstash Vector (Free Vector DB with Built-in Embeddings — https://console.upstash.com)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Upstash Redis (Free Session History Store — https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RAG Ingestion Secret (For securing POST /api/rag/ingest)
RAG_INGEST_SECRET=
